{
  "name": "sahar-police-station",
  "version": "2.0.0",
  "private": true,
  "description": "Sahar Police Station prototype application",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "npm run build:frontend && npm run build:server",
    "start": "node server/dist/index.js",
    "test": "vitest run",
    "prisma:prepare": "node server/scripts/preparePrisma.js",
    "prisma:generate": "node server/scripts/preparePrisma.js && prisma generate --schema=server/prisma/schema.prisma",
    "prisma:push": "node server/scripts/preparePrisma.js && prisma db push --schema=server/prisma/schema.prisma",
    "create-officer": "tsx server/src/scripts/createOfficer.ts",
    "seed": "tsx server/src/scripts/seed.ts",
    "seed:test-records": "tsx server/src/scripts/seedTestRecords.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "file-type": "^22.3.0",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
    "puppeteer-core": "^25.18.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
